  m_Script: {fileID: 11500000, guid: 73b0c9ab7ca9ddf438ea4227600ef2b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  briefingPanel: {fileID: 4290381221629113492}
  briefingText: {fileID: 552200790748646370}
  spaceToContinueText: {fileID: 2027860530524117744}
  typingSpeed: 0.03
  spacePromptFadeSpeed: 1.5
  briefingMessage: "Alright, listen up. We're here for the big scores on the list.
    Stick with the crew\u2014you\u2019re going to need to coordinate to pull this
    off. Use the radio, but be careful: the lone guard on duty is equipped with high-end
    listening gear. If you see him stop moving, he's likely trying to listen in on
    us. If a door is locked or a laser is in the way, smash the glass or cut the
    power. Let's get in and get out."
